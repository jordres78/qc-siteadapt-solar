    given-names: "Jorge Andrés"
    affiliation: "Universidad de Nariño"
    email: "jordres78@udenar.edu.co"
keywords:
  - control de calidad
  - irradiancia solar
  - site-adaptation
  - aprendizaje automático
  - BSRN
  - recurso solar
references:
